# Токен бота из https://discord.com/developers/applications
DISCORD_TOKEN=

# Твой Discord ID (можно несколько через запятую): 123456789012345678,987654321098765432
ADMIN_IDS=

# Часовой пояс бота (используется для времени ивентов)
TZ=Europe/Moscow

# ID сервера (guild). Если задан — команды появляются мгновенно, а не через час.
# Узнать: Правая кнопка по серверу -> Копировать ID сервера (нужен режим разработчика в Discord)
GUILD_ID=

# --- Google Таблицы ---
# Путь к JSON-ключу сервисного аккаунта (например ./credentials.json)
GOOGLE_CREDENTIALS_FILE=

# ID таблицы из её ссылки: https://docs.google.com/spreadsheets/d/ТУТ_ID/edit
SPREADSHEET_ID=